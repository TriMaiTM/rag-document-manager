<% content_for :title, "Tài liệu · #{@workspace.name} · Codexys" %>

<section class="settings-page">
  <%= render "workspaces/settings_tabs" %>

  <div class="settings-content settings-content--wide">
    <section class="settings-section">
      <header class="settings-section__header" style="margin-bottom: 1.5rem;">
        <div>
          <h1 id="documents-title" style="font-size: 1.5rem; font-weight: 700; color: var(--ui-text); margin-bottom: 0.25rem;">Tài liệu</h1>
          <p style="font-size: 0.875rem; color: var(--ui-muted); margin: 0;">Trong <%= @workspace.name %></p>
        </div>
      </header>

      <div class="resource-list" id="documents">
        <% if @documents.any? %>
          <% @documents.each do |document| %>
            <article class="resource-row" id="<%= dom_id(document) %>">
              <%= ui_icon "document-text-outline", class_name: "resource-icon" %>
              <div class="resource-primary">
                <%= link_to document.title, workspace_document_path(@workspace, document) %>
                <small>
                  <%= document.file.filename %> · <%= document_file_size(document) %>
                  · <%= document.page_count || "—" %> trang
                </small>
              </div>
              <div class="resource-actions">
                <div class="status-badge-slot">
                  <%= render "processing_status", document: document %>
                </div>
                <%= link_to workspace_document_path(@workspace, document), class: "button button--secondary doc-preview-btn", title: "Xem nội dung PDF" do %>
                  <%= ui_icon "eye-outline" %>
                  <span>Xem PDF</span>
                <% end %>
              </div>
            </article>
          <% end %>
        <% else %>
          <div class="empty-state">
            <div>
              <h2>Workspace chưa có tài liệu</h2>
              <p>Tải PDF lên để Codexys trích xuất nội dung, tạo embedding và bắt đầu hỏi đáp.</p>
            </div>
          </div>
        <% end %>
      </div>

      <% if policy(@document_context).create? %>
        <%= form_with model: [ @workspace, @document_context ],
                      class: "upload-zone",
                      style: "margin-top: 1.5rem;",
                      data: { controller: "file-upload" } do |form| %>
          <div class="upload-zone__inner">
            <%= ui_icon "cloud-upload-outline", class_name: "upload-zone__icon" %>
            <strong>Nhấn để tải lên hoặc kéo và thả nhiều tệp</strong>
            <p>Hỗ trợ tệp PDF tối đa 20 MB và <%= Documents::ExtractText::MAX_PAGE_COUNT %> trang mỗi tệp</p>

            <div class="upload-title-container" data-file-upload-target="titleContainer">
              <%= form.label :title, "Tên tài liệu", class: "visually-hidden" %>
              <%= form.text_field :title,
                maxlength: 200,
                class: "upload-title-field",
                placeholder: "Tên tài liệu (để trống sẽ tự lấy theo tên tệp)",
                data: { file_upload_target: "titleInput" } %>
            </div>

            <div class="selected-files-preview" data-file-upload-target="fileList" style="display: none;"></div>

            <%= form.label :files, "Tệp PDF", class: "visually-hidden" %>
            <%= form.file_field :files,
              multiple: true,
              required: true,
              accept: "application/pdf,.pdf",
              data: { file_upload_target: "input", action: "change->file-upload#filesChanged" } %>

            <%= form.submit "Tải lên và xử lý",
              class: "button button--primary",
              data: { file_upload_target: "submitBtn" } %>
          </div>
        <% end %>
      <% end %>
    </section>
  </div>
</section>
