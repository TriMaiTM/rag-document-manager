<%= render "shared/form_errors",
  object: document,
  title: "Không thể tải tài liệu lên" %>

<%= form_with model: [ workspace, document ], class: "upload-zone upload-zone--standalone" do |form| %>
  <div class="upload-zone__inner">
    <%= ui_icon "cloud-upload-outline", class_name: "upload-zone__icon" %>
    <strong>Nhấn để tải lên hoặc kéo và thả</strong>
    <p>
      Chỉ nhận PDF, tối đa 20 MB và không quá
      <%= Documents::ExtractText::MAX_PAGE_COUNT %> trang
    </p>

    <%= form.label :title, "Tên tài liệu", class: "visually-hidden" %>
    <%= form.text_field :title,
      required: true,
      maxlength: 200,
      autofocus: true,
      class: "upload-title-field",
      placeholder: "Tên tài liệu, ví dụ: Ruby on Rails Guide" %>

    <%= form.label :file, "Tệp PDF", class: "visually-hidden" %>
    <%= form.file_field :file,
      required: true,
      accept: "application/pdf,.pdf" %>

    <div class="form-actions">
      <%= link_to "Hủy", workspace_documents_path(workspace), class: "button button--ghost" %>
      <%= form.submit "Tải lên và xử lý", class: "button button--primary" %>
    </div>
  </div>
<% end %>
