<% content_for :title, "Tải tài liệu lên · #{@workspace.name} · Codexys" %>

<section class="settings-page">
  <%= render "workspaces/settings_tabs" %>

  <div class="settings-content">
    <section class="settings-section">
      <header class="settings-section__header" style="margin-bottom: 1.5rem;">
        <h1 id="upload-document-title" style="font-size: 1.5rem; font-weight: 700; color: var(--ui-text); margin-bottom: 0.25rem;">Tải tài liệu lên</h1>
        <p style="font-size: 0.875rem; color: var(--ui-muted); margin: 0;">Thêm tệp PDF vào <%= @workspace.name %> để xử lý embedding</p>
      </header>

      <%= render "form", workspace: @workspace, document: @document %>
    </section>
  </div>
</section>
