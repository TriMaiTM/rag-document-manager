<% content_for :title, "#{@document.title} · #{@workspace.name} · Codexys" %>

<section class="settings-page">
  <%= render "workspaces/settings_tabs" %>

  <div class="settings-content settings-content--wide">
    <section class="settings-section">
      <header class="settings-section__header" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
          <h1 id="document-title" style="font-size: 1.5rem; font-weight: 700; color: var(--ui-text); margin-bottom: 0.25rem;"><%= @document.title %></h1>
          <p style="font-size: 0.875rem; color: var(--ui-muted); margin: 0;"><%= @document.file.filename %></p>
        </div>

        <%= link_to (@document.pdf? ? "Tải PDF xuống" : "Tải #{@document.extension.upcase} xuống"),
          download_workspace_document_path(@workspace, @document),
          class: "button button--secondary button--compact" %>
      </header>

      <section class="surface-card surface-card--spaced" style="margin-bottom: 1.5rem;">
        <header class="surface-card__header">
          <div>
            <h2>Thông tin tài liệu</h2>
            <p>Thông tin tệp và vòng đời xử lý.</p>
          </div>
          <%= render "processing_status", document: @document %>
        </header>

        <dl class="detail-list">
          <dt>Tên tệp</dt>
          <dd><%= @document.file.filename %></dd>
          <dt>Dung lượng</dt>
          <dd><%= document_file_size(@document) %></dd>
          <dt>Số trang / phân đoạn</dt>
          <dd><%= @document.page_count || "Chưa xác định" %></dd>
          <dt>Người tải lên</dt>
          <dd><%= @document.uploaded_by.email %></dd>
          <dt>Thời gian tải lên</dt>
          <dd><%= @document.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
          <dt>Bắt đầu xử lý</dt>
          <dd><%= document_lifecycle_time(@document.processing_started_at) %></dd>
          <% if @document.completed? %>
            <dt>Hoàn thành lúc</dt>
            <dd><%= document_lifecycle_time(@document.completed_at) %></dd>
          <% elsif @document.failed? %>
            <dt>Thất bại lúc</dt>
            <dd><%= document_lifecycle_time(@document.failed_at) %></dd>
          <% end %>
        </dl>
      </section>

      <% if @document.file.attached? %>
        <section class="surface-card surface-card--spaced" style="margin-bottom: 1.5rem;">
          <header class="surface-card__header">
            <div>
              <h2>Nội dung tài liệu</h2>
              <p>Xem trực tiếp nội dung tệp trong ứng dụng.</p>
            </div>
            <% if @document.pdf? %>
              <%= link_to rails_blob_path(@document.file, disposition: "inline"), target: "_blank", class: "button button--secondary button--compact", rel: "noopener" do %>
                <%= ui_icon "open-outline" %>
                <span>Mở tab mới</span>
              <% end %>
            <% end %>
          </header>

          <% if @document.pdf? %>
            <div class="pdf-viewer-container">
              <iframe
                src="<%= rails_blob_path(@document.file, disposition: "inline") %>"
                title="<%= @document.title %>"
                class="pdf-viewer-iframe">
              </iframe>
            </div>
          <% elsif @document.text_based? %>
            <div class="text-viewer-container" style="background: var(--ui-surface-soft, #f8fafc); border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); padding: 1.5rem; max-height: 500px; overflow-y: auto; font-family: monospace; font-size: 0.875rem; line-height: 1.6; white-space: pre-wrap; color: var(--ui-text);">
              <%= @document.file.download.force_encoding('UTF-8') %>
            </div>
          <% else %>
            <% docx_data = document_docx_content(@document) %>
            <div class="docx-preview-box" style="padding: 0.5rem 0; max-height: 560px; overflow-y: auto; font-size: 0.95rem; line-height: 1.8; color: var(--ui-text);">
              <% if docx_data[:paragraphs].any? || docx_data[:tables].any? %>
                <% docx_data[:paragraphs].each do |para| %>
                  <p style="margin-bottom: 1.2rem; text-align: justify; word-break: break-word;"><%= para %></p>
                <% end %>

                <% if docx_data[:tables].any? %>
                  <% docx_data[:tables].each do |table| %>
                    <div style="margin: 1.5rem 0; overflow-x: auto;">
                      <table style="width: 100%; border-collapse: collapse; border: 1px solid var(--ui-border); font-size: 0.875rem;">
                        <% table.each_with_index do |row, r_idx| %>
                          <tr style="<%= r_idx.zero? ? 'background: var(--ui-surface-soft, #f8fafc); font-weight: 600;' : '' %>">
                            <% row.each do |cell| %>
                              <td style="border: 1px solid var(--ui-border); padding: 0.6rem 0.75rem;"><%= cell %></td>
                            <% end %>
                          </tr>
                        <% end %>
                      </table>
                    </div>
                  <% end %>
                <% end %>
              <% else %>
                <p style="color: var(--ui-muted); font-style: italic; text-align: center; padding: 2rem;">Tài liệu chưa có nội dung hoặc đang trong hàng đợi xử lý.</p>
              <% end %>
            </div>
          <% end %>
        </section>
      <% end %>

      <% if @document.failed? %>
        <div class="alert-panel alert-panel--spaced" role="alert" style="margin-bottom: 1.5rem;">
          <div class="alert-panel__icon" aria-hidden="true">!</div>
          <div>
            <h2>Không thể xử lý tài liệu</h2>
            <p><%= document_processing_error_message(@document) %></p>
          </div>
        </div>
      <% end %>

      <% if @document.failed? && policy(@document).retry_processing? %>
        <section class="surface-card" style="margin-bottom: 1.5rem;">
          <header class="surface-card__header">
            <div>
              <h2>Xử lý lại tài liệu</h2>
              <p>Đưa tài liệu vào hàng đợi để hệ thống xử lý lại từ đầu.</p>
            </div>
          </header>
          <%= button_to "Thử xử lý lại",
            retry_processing_workspace_document_path(@workspace, @document),
            method: :post,
            class: "button button--secondary" %>
        </section>
      <% end %>

      <% if policy(@document).destroy? %>
        <section class="danger-zone">
          <h2>Vùng nguy hiểm</h2>
          <p>Xóa tài liệu cũng xóa toàn bộ chunks và embeddings liên quan.</p>
          <%= button_to "Xóa tài liệu",
            workspace_document_path(@workspace, @document),
            method: :delete,
            class: "button button--danger button--compact",
            form: { data: { turbo_confirm: "Xóa tài liệu này?" } } %>
        </section>
      <% end %>
    </section>
  </div>
</section>
