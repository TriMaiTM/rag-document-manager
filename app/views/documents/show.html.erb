<main>
  <article>
    <header>
      <h1><%= @document.title %></h1>

      <p>
        Trạng thái:
        <strong>
          <%= document_status_label(@document) %>
        </strong>
      </p>
    </header>

    <dl>
      <dt>Tên tệp</dt>
      <dd><%= @document.file.filename %></dd>

      <dt>Dung lượng</dt>
      <dd><%= document_file_size(@document) %></dd>

      <dt>Người tải lên</dt>
      <dd><%= @document.uploaded_by.email %></dd>

      <dt>Thời gian tải lên</dt>
      <dd>
        <%= @document.created_at.strftime(
          "%d/%m/%Y %H:%M"
        ) %>
      </dd>
    </dl>

    <nav>
      <%= link_to "Tải PDF xuống",
        download_workspace_document_path(
          @workspace,
          @document
        ) %>

      <%= link_to "Danh sách tài liệu",
        workspace_documents_path(@workspace) %>
    </nav>

    <% if @document.failed? && policy(@document).retry_processing? %>
      <section>
        <h2>Xử lý lại tài liệu</h2>

        <p>
          Lần xử lý trước không thành công. Bạn có thể đưa tài liệu vào
          hàng đợi để hệ thống thử lại.
        </p>

        <%= button_to "Thử xử lý lại",
          retry_processing_workspace_document_path(
            @workspace,
            @document
          ),
          method: :post %>
      </section>
    <% end %>

    <% if policy(@document).destroy? %>
      <section>
        <h2>Vùng nguy hiểm</h2>

        <%= button_to "Xóa tài liệu",
          workspace_document_path(
            @workspace,
            @document
          ),
          method: :delete,
          form: {
            data: {
              turbo_confirm: "Xóa tài liệu này?"
            }
          } %>
      </section>
    <% end %>
  </article>
</main>
