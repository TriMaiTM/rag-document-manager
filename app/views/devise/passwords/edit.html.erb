<% content_for :title, "Đặt lại mật khẩu · Codexys" %>

<div class="auth-card">
  <div class="auth-brand">
    <%= image_tag "codexys/logo.png", alt: "" %>
    <span>Codexys</span>
  </div>

  <h1>Đặt lại mật khẩu</h1>
  <p class="auth-card__intro">Chọn mật khẩu mới cho tài khoản của bạn.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= form.hidden_field :reset_password_token %>

    <div class="field">
      <%= form.label :password, "Mật khẩu mới" %>
      <%= form.password_field :password, autofocus: true, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Xác nhận mật khẩu mới" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
    <div class="actions"><%= form.submit "Đổi mật khẩu", class: "button button--primary" %></div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
