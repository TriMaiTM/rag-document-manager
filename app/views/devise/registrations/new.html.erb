<% content_for :title, "Tạo tài khoản · Codexys" %>

<div class="auth-page">
  <%= render "devise/shared/auth_nav" %>

  <div class="auth-page__body">
    <div class="auth-page__container">
      <!-- Form Column -->
      <div class="auth-box">
        <div class="auth-box__header">
          <h1 class="auth-box__title">Bắt đầu cùng Codexys.</h1>
          <p class="auth-box__subtitle">Xây dựng thư viện tri thức có thể hỏi đáp với trợ lý AI chuyên sâu.</p>
        </div>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form-neo" }) do |form| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="auth-input-group">
            <%= form.label :email, "Email", class: "auth-input-label" %>
            <%= form.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "auth-input-field" %>
          </div>

          <div class="auth-input-group">
            <%= form.label :password, "Mật khẩu", class: "auth-input-label" %>
            <%= form.password_field :password,
              autocomplete: "new-password",
              placeholder: @minimum_password_length ? "Tối thiểu #{@minimum_password_length} ký tự" : "Mật khẩu",
              class: "auth-input-field" %>
          </div>

          <div class="auth-input-group">
            <%= form.label :password_confirmation, "Xác nhận mật khẩu", class: "auth-input-label" %>
            <%= form.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "Nhập lại mật khẩu",
              class: "auth-input-field" %>
          </div>

          <div class="auth-btn-row">
            <%= form.submit "Tạo tài khoản ngay", class: "btn-hero-neo btn-hero-neo--primary btn-hero-neo--full" %>
          </div>
        <% end %>

        <div class="auth-box__footer">
          <span>Đã có tài khoản?</span>
          <%= link_to "Đăng nhập ngay", new_session_path(resource_name), class: "auth-link-bold" %>
        </div>
      </div>

      <!-- Animated Orbit Showcase Column -->
      <%= render "devise/shared/auth_orbit" %>
    </div>
  </div>
</div>
