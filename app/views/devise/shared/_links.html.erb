<nav class="auth-links" aria-label="Liên kết tài khoản">
  <% if controller_name != "sessions" %>
    <%= link_to "Đăng nhập", new_session_path(resource_name) %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Tạo tài khoản", new_registration_path(resource_name) %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" %>
    <%= link_to "Quên mật khẩu?", new_password_path(resource_name) %>
  <% end %>
</nav>
