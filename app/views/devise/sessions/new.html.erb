<% content_for :title, "Đăng nhập · Codexys" %>

<div class="auth-page">
  <%= render "devise/shared/auth_nav" %>

  <div class="auth-page__body">
    <div class="auth-page__container">
      <!-- Form Column -->
      <div class="auth-box">
        <div class="auth-box__header">
          <h1 class="auth-box__title">Đăng nhập vào Codexys.</h1>
          <p class="auth-box__subtitle">Tiếp tục khai thác tri thức tài liệu và hội thoại chuyên sâu.</p>
        </div>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form-neo" }) do |form| %>
          <div class="auth-input-group">
            <%= form.label :email, "Email", class: "auth-input-label" %>
            <%= form.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "auth-input-field" %>
          </div>

          <div class="auth-input-group">
            <div class="auth-input-header">
              <%= form.label :password, "Mật khẩu", class: "auth-input-label" %>
              <% if devise_mapping.recoverable? %>
                <%= link_to "Quên mật khẩu?", new_password_path(resource_name), class: "auth-link-subtle" %>
              <% end %>
            </div>
            <%= form.password_field :password,
              autocomplete: "current-password",
              placeholder: "Nhập mật khẩu của bạn",
              class: "auth-input-field" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="auth-checkbox-group">
              <label class="auth-checkbox-control">
                <%= form.check_box :remember_me, class: "auth-checkbox-input" %>
                <span>Ghi nhớ phiên đăng nhập</span>
              </label>
            </div>
          <% end %>

          <div class="auth-btn-row">
            <%= form.submit "Đăng nhập ngay", class: "btn-hero-neo btn-hero-neo--primary btn-hero-neo--full" %>
          </div>
        <% end %>

        <div class="auth-box__footer">
          <span>Chưa có tài khoản?</span>
          <%= link_to "Tạo tài khoản mới", new_registration_path(resource_name), class: "auth-link-bold" %>
        </div>
      </div>

      <!-- Animated Orbit Showcase Column -->
      <%= render "devise/shared/auth_orbit" %>
    </div>
  </div>
</div>
