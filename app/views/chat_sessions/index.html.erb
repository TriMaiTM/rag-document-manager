<% content_for :title, "Hỏi đáp tài liệu · #{@workspace.name} · Codexys" %>

<section class="chat-page chat-page--empty">

  <div class="chat-empty-layout">
    <div class="chat-empty-state">
      <%= image_tag "codexys/landing-logo.png", class: "chat-empty-logo", alt: "Codexys Logo" %>
      <h2>Bạn muốn hỏi điều gì về tài liệu?</h2>
      <p>
        Đặt câu hỏi về các tài liệu đã xử lý trong <strong><%= @workspace.name %></strong>.
        Codexys sẽ trả lời kèm nguồn để bạn kiểm chứng.
      </p>
    </div>

    <% if @chat_error.present? %>
      <div class="inline-alert" role="alert"><%= @chat_error %></div>
    <% end %>

    <div class="chat-empty-composer">
      <%= form_with url: workspace_chat_sessions_path(@workspace),
        class: "composer",
        data: { controller: "composer" } do |form| %>
        <%= form.label :question, "Câu hỏi", class: "visually-hidden" %>
        <%= form.text_area :question,
          value: @question,
          required: true,
          minlength: SemanticSearch::Search::MIN_QUERY_LENGTH,
          maxlength: SemanticSearch::Search::MAX_QUERY_LENGTH,
          rows: 1,
          autofocus: true,
          placeholder: "Send a message...",
          data: {
            composer_target: "input",
            action: "input->composer#resize keydown->composer#submitOnEnter"
          } %>

        <div class="composer__footer">
          <div class="composer__model-picker">
            <%= select_tag :model,
              options_for_select([
                ["Gemini 3.5 Flash-Lite", "gemini-3.5-flash-lite"],
                ["Gemini 2.5 Flash", "gemini-2.5-flash"],
                ["Gemini 2.5 Pro", "gemini-2.5-pro"],
                ["Gemini 1.5 Flash", "gemini-1.5-flash"],
                ["Gemini 1.5 Pro", "gemini-1.5-pro"]
              ], params[:model] || "gemini-3.5-flash-lite"),
              class: "composer__model-select",
              aria: { label: "Chọn mô hình AI" } %>
            <%= ui_icon "chevron-down-outline", class_name: "composer__model-icon" %>
          </div>
          <%= form.button type: :submit,
            class: "composer__submit",
            aria: { label: "Gửi câu hỏi" },
            data: { turbo_submits_with: "…" } do %>
            <%= ui_icon "arrow-up-outline" %>
          <% end %>
        </div>
      <% end %>

      <p class="ai-disclaimer">
        Codexys có thể mắc lỗi. Hãy kiểm tra thông tin quan trọng trong nguồn trích dẫn.
      </p>
    </div>
  </div>
</section>
