<% if object.errors.any? %>
  <section class="alert-panel" role="alert">
    <div class="alert-panel__icon" aria-hidden="true">!</div>

    <div>
      <h2><%= title %></h2>
      <ul>
        <% object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </section>
<% end %>
