<main>
  <header>
    <h1>Đăng ký tài khoản</h1>

    <p>Tạo tài khoản để bắt đầu sử dụng Codexys.</p>
  </header>

  <%= form_with model: @user, url: registration_path do |form| %>
    <% if @user.errors.any? %>
      <section role="alert">
        <h2>Không thể tạo tài khoản</h2>

        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <div>
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address,
        required: true,
        autofocus: true,
        autocomplete: "email",
        placeholder: "you@example.com" %>
    </div>

    <div>
      <%= form.label :password, "Mật khẩu" %>
      <%= form.password_field :password,
        required: true,
        minlength: 8,
        maxlength: 72,
        autocomplete: "new-password" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Nhập lại mật khẩu" %>
      <%= form.password_field :password_confirmation,
        required: true,
        minlength: 8,
        maxlength: 72,
        autocomplete: "new-password" %>
    </div>

    <div>
      <%= form.submit "Tạo tài khoản" %>
    </div>
  <% end %>

  <%= link_to "Đã có tài khoản? Đăng nhập", new_session_path %>
</main>
