<% content_for :title, "Tạo Workspace · Codexys" %>

<section class="settings-page">
  <nav class="settings-tabs" aria-label="Tạo Workspace">
    <%= link_to workspaces_path, class: "settings-tabs__back", aria: { label: "Quay lại" } do %>
      <%= ui_icon "arrow-back-outline" %>
    <% end %>
    <span class="settings-tab settings-tab--active">Tạo Workspace</span>
  </nav>

  <div class="settings-content">
    <section class="settings-section">
      <h1>Tạo Workspace</h1>
      <p>Workspace chứa tài liệu, thành viên và toàn bộ cuộc trò chuyện liên quan.</p>
      <%= render "form", workspace: @workspace %>
    </section>
  </div>
</section>
