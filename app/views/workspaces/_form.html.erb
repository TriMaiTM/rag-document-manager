<%= render "shared/form_errors", object: workspace, title: "Không thể lưu Workspace" %>

<%= form_with model: workspace, class: "form-stack" do |form| %>
  <div class="form-field">
    <%= form.label :name, "Tên Workspace" %>
    <%= form.text_field :name,
      required: true,
      maxlength: 100,
      autofocus: true,
      placeholder: "Ví dụ: Tài liệu đồ án" %>
    <p class="form-field__hint">Tên này được hiển thị ở thanh Workspace bên trái.</p>
  </div>

  <div class="form-field">
    <%= form.label :description, "Mô tả" %>
    <%= form.text_area :description,
      rows: 5,
      maxlength: 1_000,
      placeholder: "Workspace này được dùng để lưu trữ và hỏi đáp về..." %>
  </div>

  <div class="form-actions">
    <%= link_to "Hủy",
      workspace.persisted? ? workspace_path(workspace) : workspaces_path,
      class: "button button--ghost" %>
    <%= form.submit workspace.persisted? ? "Cập nhật Workspace" : "Tạo Workspace",
      class: "button button--primary" %>
  </div>
<% end %>
