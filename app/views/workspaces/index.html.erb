<% content_for :title, "Workspaces · Codexys" %>

<section class="page-shell">
  <header class="page-heading">
    <div>
      <p class="page-heading__eyebrow">Codexys</p>
      <h1>Danh sách Workspace</h1>
      <p>Chọn không gian làm việc để trò chuyện với bộ tài liệu tương ứng.</p>
    </div>
    <div class="page-heading__actions">
      <%= link_to "Tạo Workspace", new_workspace_path, class: "button button--primary" %>
    </div>
  </header>

  <% if @workspaces.any? %>
    <div id="workspaces" class="workspace-grid">
      <% @workspaces.each do |workspace| %>
        <article class="workspace-card">
          <header class="workspace-card__header">
            <h2><%= link_to workspace.name, workspace_chat_sessions_path(workspace) %></h2>
          </header>
          <p><%= workspace.description.presence || "Workspace chưa có mô tả." %></p>
          <footer class="workspace-card__footer">
            <span><%= workspace.documents.count %> tài liệu</span>
            <%= link_to "Mở Workspace →", workspace_chat_sessions_path(workspace) %>
          </footer>
        </article>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
      icon: "+",
      title: "Bạn chưa có Workspace nào",
      description: "Tạo Workspace đầu tiên để tải tài liệu và bắt đầu hỏi đáp.",
      action_label: "Tạo Workspace",
      action_path: new_workspace_path %>
  <% end %>
</section>
