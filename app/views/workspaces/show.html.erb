<% content_for :title, "#{@workspace.name} · Codexys" %>

<section class="settings-page">
  <%= render "workspaces/settings_tabs" %>

  <div class="settings-content settings-content--wide">
    <section class="settings-section">
      <header class="page-heading" style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.5rem;">
        <div>
          <p class="page-heading__eyebrow" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--ui-primary); margin-bottom: 0.25rem;"><%= membership_role_label(@membership) %></p>
          <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--ui-text); margin-bottom: 0.25rem;"><%= @workspace.name %></h1>
          <p style="font-size: 0.875rem; color: var(--ui-muted); margin: 0;"><%= @workspace.description.presence || "Workspace này chưa có mô tả." %></p>
        </div>
        <div class="page-heading__actions" style="display: flex; gap: 0.5rem;">
          <% if policy(@workspace).update? %>
            <%= link_to "Chỉnh sửa Workspace", edit_workspace_path(@workspace), class: "button button--secondary" %>
          <% end %>
          <%= link_to "Hỏi đáp tài liệu", workspace_chat_sessions_path(@workspace), class: "button button--primary" %>
        </div>
      </header>

      <div class="dashboard-grid" style="margin-bottom: 1.5rem;">
        <article class="stat-card"><span>Tổng tài liệu</span><strong><%= @document_count %></strong></article>
        <article class="stat-card"><span>Đã xử lý</span><strong><%= @completed_document_count %></strong></article>
        <article class="stat-card"><span>Thành viên</span><strong><%= @member_count %></strong></article>
      </div>

      <div class="quick-actions" style="margin-bottom: 1.5rem;">
        <%= link_to workspace_chat_sessions_path(@workspace), class: "quick-action" do %>
          <strong>Hỏi đáp tài liệu</strong>
        <% end %>
        <%= link_to workspace_documents_path(@workspace), class: "quick-action" do %>
          <strong>Quản lý tài liệu</strong>
        <% end %>
        <% if policy(@workspace).manage_members? %>
          <%= link_to workspace_memberships_path(@workspace), class: "quick-action" do %>
            <strong>Quản lý thành viên</strong>
          <% end %>
        <% else %>
          <div class="quick-action"><strong><%= @member_count %> thành viên</strong></div>
        <% end %>
      </div>

      <% if @recent_documents.any? %>
        <div class="surface-card surface-card--spaced">
          <header class="surface-card__header">
            <div><h2>Tài liệu gần đây</h2><p>Các tài liệu mới nhất trong Workspace.</p></div>
            <%= link_to "Xem tất cả", workspace_documents_path(@workspace), class: "button button--ghost button--compact" %>
          </header>
          <div class="table-shell">
            <table class="data-table">
              <tbody>
                <% @recent_documents.each do |document| %>
                  <tr>
                    <td class="table-primary">
                      <%= link_to document.title, workspace_document_path(@workspace, document) %>
                      <small><%= document.created_at.strftime("%d/%m/%Y %H:%M") %></small>
                    </td>
                    <td><%= render "documents/processing_status", document: document %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</section>
