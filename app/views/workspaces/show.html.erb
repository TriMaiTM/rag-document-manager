<main>
  <article>
    <header>
      <h1><%= @workspace.name %></h1>
    </header>

    <% if policy(@workspace).update? %>
      <nav>
        <%= link_to "Chỉnh sửa Workspace",
          edit_workspace_path(@workspace) %>
      </nav>
    <% end %>

    <% if policy(@workspace).manage_members? %>
      <nav>
        <%= link_to "Quản lý thành viên",
          workspace_memberships_path(@workspace) %>
      </nav>
    <% end %>

    <% if @workspace.description.present? %>
      <section>
        <h2>Mô tả</h2>

        <%= simple_format @workspace.description %>
      </section>
    <% else %>
      <p>Workspace này chưa có mô tả.</p>
    <% end %>

    <footer>
      <p>
        Được tạo lúc:
        <%= @workspace.created_at.strftime("%d/%m/%Y %H:%M") %>
      </p>

      <%= link_to "Danh sách Workspace", workspaces_path %>
    </footer>

    <% if policy(@workspace).destroy? %>
      <section>
        <h2>Vùng nguy hiểm</h2>

        <p>
          Workspace sau khi xóa sẽ không thể khôi phục.
        </p>

        <%= button_to "Xóa Workspace",
          workspace_path(@workspace),
          method: :delete,
          form: {
            data: {
              turbo_confirm: "Bạn có chắc muốn xóa Workspace này?"
            }
          } %>
      </section>
    <% end %>
  </article>
</main>
